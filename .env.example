# Runtime profile and HTTP port. Secrets must be supplied by the deployment environment.
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
MANAGEMENT_SERVER_ADDRESS=127.0.0.1
MANAGEMENT_SERVER_PORT=8081
DB_URL=jdbc:postgresql://localhost:5432/altneb
DB_USERNAME=altneb
DB_PASSWORD=replace-with-local-password
# Generate a random 32-byte value and Base64-encode it. Never commit the real value.
JWT_SECRET_BASE64=replace-with-base64-encoded-32-byte-secret
JWT_ISSUER=altneb-api
JWT_AUDIENCE=altneb-web
JWT_ACCESS_TOKEN_TTL=PT15M
JWT_REFRESH_TOKEN_TTL=P7D
CORS_ALLOWED_ORIGINS=http://localhost:3000
REFRESH_COOKIE_SECURE=false
